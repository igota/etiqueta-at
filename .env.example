# Copie este arquivo para ".env" e coloque-o na mesma pasta do run.exe
# (build) ou do app.py/run.py (dev). Nunca comite o ".env" real — ele já
# está no .gitignore.

# URL base do sistema do hospital (sem a barra final)
HOSPITAL_BASE_URL=http://<host>:<porta>/pacientehrn

# Chave de sessão do Flask
FLASK_SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# Servidor (Waitress)
HOST=0.0.0.0
PORT=5000
THREADS=100

# Caminho do ícone exibido na bandeja do sistema (opcional — por padrão usa
# static/icone_etiquetaAT.jpg na mesma pasta do run.exe/run.py)
# ICON_PATH=C:\caminho\onde\o\run.exe\estiver\static\icone_etiquetaAT.jpg
